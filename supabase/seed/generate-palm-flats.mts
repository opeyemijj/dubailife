// Generates supabase/seed/palm-flats.sql: homes in Palm Jumeirah's residences (lib/city/palm.ts).
// Deterministic, and re-running only adds missing flats. Run: npx tsx supabase/seed/generate-palm-flats.mts
//
// Prices are in-game AED anchored to 2026 Palm Jumeirah levels: trunk apartments ~AED 3,500–4,500/sq ft,
// Garden Homes ~AED 25–30m, Signature Villas and beachfront crescent villas far higher.

import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";
import { PALM_ENTITIES } from "../../src/lib/city/palm";

const here = path.dirname(fileURLToPath(import.meta.url));

function rng(key: string) {
  let h = 2166136261;
  for (const c of key) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return ((h ^= h >>> 16) >>> 0) / 4294967296;
  };
}

const NPCS = ["Sarah Al Mansoori", "Omar Haddad", "Elena Petrova", "James Whitaker", "Noura Al Hashimi", "Ravi Menon", "Marco Rossi", "Mei Lin", "Khalid Al Suwaidi", "Sofia Martins"];

const TYPES: Record<string, { bedrooms: number; sqft: [number, number]; rent: number; ppsf: number }> = {
  "1 Bedroom": { bedrooms: 1, sqft: [850, 1100], rent: 15000, ppsf: 3600 },
  "2 Bedroom": { bedrooms: 2, sqft: [1400, 1700], rent: 22000, ppsf: 3700 },
  "3 Bedroom": { bedrooms: 3, sqft: [2000, 2500], rent: 32000, ppsf: 3900 },
  Penthouse: { bedrooms: 4, sqft: [4000, 5200], rent: 75000, ppsf: 4800 },
  "Garden Home": { bedrooms: 4, sqft: [5000, 6000], rent: 55000, ppsf: 5000 },
  "Signature Villa": { bedrooms: 5, sqft: [7000, 8000], rent: 110000, ppsf: 7500 },
};

const round = (n: number, to: number) => Math.round(n / to) * to;
const q = (v: unknown) => (v === null || v === undefined ? "null" : typeof v === "number" ? String(v) : `'${String(v).replace(/'/g, "''")}'`);

function occupancy(r: () => number) {
  const x = r();
  if (x < 0.35) return { owner_npc: NPCS[Math.floor(r() * NPCS.length)] };
  if (x < 0.5) return { tenant_npc: NPCS[Math.floor(r() * NPCS.length)] };
  if (x < 0.78) return { listing: "rent" };
  if (x < 0.92) return { listing: "sale" };
  return { listing: "rent_or_sale" };
}

const rows: Array<Record<string, unknown>> = [];
function add(buildingId: string, unit: string, floor: number, type: string, r: () => number, views: string[]) {
  const t = TYPES[type];
  const sqft = round(t.sqft[0] + r() * (t.sqft[1] - t.sqft[0]), 5);
  const occ = occupancy(r);
  const lift = 1 + floor * 0.006;
  rows.push({
    id: `${buildingId}:${unit}`, building_id: buildingId, unit, floor,
    // Villas are stored as the "Villa" type the game already knows; the name says which kind.
    property_type: type === "Garden Home" || type === "Signature Villa" ? "Villa" : type,
    bedrooms: t.bedrooms, size_sqft: sqft, view: views[Math.floor(r() * views.length)],
    owner_npc: occ.owner_npc ?? null, tenant_npc: occ.tenant_npc ?? null, listing: occ.listing ?? "none",
    rent_price: round(t.rent * lift * (0.92 + r() * 0.16), 500),
    sale_price: round(sqft * t.ppsf * lift * (0.94 + r() * 0.12), 50000),
    access: occ.owner_npc || occ.tenant_npc ? (r() < 0.25 ? "public" : "private") : "private",
  });
}

for (const b of PALM_ENTITIES) {
  const r = rng(b.id);
  if (b.type === "tall-building") {
    const floors = Number(b.floors ?? 10);
    for (const floor of [2, 4, Math.round(floors * 0.6), floors - 1].filter((f, i, a) => f > 1 && f < floors && a.indexOf(f) === i)) {
      ["01", "02"].forEach((suffix) => {
        const type = ["1 Bedroom", "2 Bedroom", "2 Bedroom", "3 Bedroom"][Math.floor(r() * 4)];
        add(b.id, `${floor}${suffix}`, floor, type, r, ["Sea view", "Atlantis view", "Marina skyline view", "Park view", "Burj Al Arab view"]);
      });
    }
    add(b.id, `PH${floors}`, floors, "Penthouse", r, ["Full sea & Palm view"]);
  } else if (b.type === "dubai-villa") {
    const signature = String(b.name).startsWith("Signature") || b.id === "xxii-carat-villa";
    add(b.id, "Villa", 0, signature ? "Signature Villa" : "Garden Home", r, ["Beachfront, Atlantis view", "Beachfront, Marina skyline view", "Private beach & lagoon view"]);
  }
}

const cols = ["id", "building_id", "unit", "floor", "property_type", "bedrooms", "size_sqft", "view", "owner_npc", "tenant_npc", "listing", "rent_price", "sale_price", "access"];
fs.writeFileSync(path.join(here, "palm-flats.sql"), [
  "-- Generated by supabase/seed/generate-palm-flats.mts from src/lib/city/palm.ts. Re-running only adds missing flats.",
  `insert into public.flats (${cols.join(", ")}) values`,
  rows.map((row) => `  (${cols.map((c) => q(row[c])).join(", ")})`).join(",\n"),
  "on conflict (id) do nothing;",
  "",
].join("\n"));
console.log(`${rows.length} Palm homes`);
